DEEPSEEK_API_KEY=你的DeepSeek密钥

# NapCat OneBot HTTP API 地址（在 NapCat WebUI 网络配置里查看，常见为 3000 或 5700）
ONEBOT_HTTP_URL=http://127.0.0.1:5700

# NapCat HTTP Server 里配置的 Token（网络配置 -> HTTP 服务端）
# 注意：不是 WebUI 登录 Token！两者不同。
ONEBOT_TOKEN=

# 机器人 QQ 号（登录 NapCat 的那个号，纯数字）
BOT_QQ=

# 可选：只允许这些群响应，逗号分隔群号；留空则所有群 @ 都会回复
QQ_ALLOWED_GROUPS=
